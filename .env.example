# ───────────────────────────────────────────────────────────────
# KIMERA TATTOO — configurazione
# Copia questo file in ".env" (sviluppo) o imposta le variabili
# sul server / servizio di hosting (produzione).
# ───────────────────────────────────────────────────────────────

# ── Build-time (PUBLIC_* finiscono nel sito: nessun segreto qui) ─
# URL definitivo del sito: usato per canonical, sitemap, Open Graph.
SITE_URL=https://www.tuodominio.it

# Numero WhatsApp in formato internazionale, solo cifre (es. 393331234567)
PUBLIC_WHATSAPP_NUMBER=
PUBLIC_CONTACT_EMAIL=
PUBLIC_CONTACT_PHONE=

# Analytics (caricati SOLO dopo il consenso cookie). Usa uno dei due.
PUBLIC_GA_MEASUREMENT_ID=
PUBLIC_PLAUSIBLE_DOMAIN=

# ── Runtime server (segreti: mai con prefisso PUBLIC_) ──────────
# Destinatario delle richieste dal modulo contatti
INQUIRY_TO=
INQUIRY_FROM="Kimera Tattoo <no-reply@tuodominio.it>"
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# "outbox" = salva le richieste su disco in ./.data/inquiries (solo sviluppo/test)
# vuoto    = invio reale via SMTP
FORM_MODE=

# Se il server sta dietro a un reverse proxy (nginx, Cloudflare…) imposta 1
# per leggere l'IP reale da X-Forwarded-For (rate limit).
TRUST_PROXY=0
