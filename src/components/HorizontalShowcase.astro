---
import Photo from './Photo.astro';
import Marks from './Marks.astro';
import Split from './Split.astro';
import Arrow from './Arrow.astro';
import { showcaseWorks, hasRealWorks, type Work } from '../data/works';
import { showcaseLines } from '../data/copy';

type Variant = 'a' | 'b' | 'macro' | 'full';
interface Slide {
  work: Work;
  variant: Variant;
  index: number; // 1-based, numerazione progressiva dei contenuti
  line: string;
  detail: boolean;
}

const works = showcaseWorks(7);
const workLines = showcaseLines.filter((l) => !l.startsWith('Dettaglio'));
const detailLines = showcaseLines.filter((l) => l.startsWith('Dettaglio'));

const slides: Slide[] = [];
let k = 0;
let d = 0;
works.forEach((w, i) => {
  const isLast = i === works.length - 1;
  let variant: Variant = w.orientation === 'landscape' ? 'b' : 'a';
  // climax a tutto schermo solo per fotografie orizzontali: nessun ritaglio aggressivo
  if (isLast && works.length >= 4 && w.orientation === 'landscape') variant = 'full';
  k += 1;
  slides.push({ work: w, variant, index: k, line: w.caption ?? workLines[(k - 1) % workLines.length], detail: false });
  // dettagli macro dopo la 2ª e la 5ª opera: ritmo verticale / orizzontale / macro
  if ((i === 1 || i === 4) && works.length > 2) {
    k += 1;
    slides.push({ work: w, variant: 'macro', index: k, line: detailLines[d % detailLines.length], detail: true });
    d += 1;
  }
});
const total = slides.length;
const pad = (n: number) => String(n).padStart(2, '0');
const sizes: Record<Variant, string> = {
  a: '(min-width: 900px) 42vw, 82vw',
  b: '(min-width: 900px) 66vw, 82vw',
  macro: '(min-width: 900px) 120vw, 170vw',
  full: '100vw',
};
const widths: Record<Variant, number[]> = {
  a: [640, 960, 1400, 1800],
  b: [800, 1200, 1800, 2400],
  macro: [1200, 1800, 2400, 3200],
  full: [1200, 1800, 2400, 3200],
};
---

<section class="showcase" id="showcase" data-showcase aria-labelledby="showcase-title">
  <div class="showcase__pin" data-pin>
    <div class="showcase__top">
      <p class="mono muted" data-reveal="fade">(01) — Esposizione</p>
      <p class="showcase__count mono" aria-hidden="true">
        <span data-cur>01</span><span class="muted"> / {pad(total)}</span>
      </p>
    </div>

    <div class="showcase__viewport" data-viewport tabindex="0" role="region" aria-label="Selezione di opere: scorri in orizzontale">
      <ol class="showcase__track" data-rail>
        <li class="slide slide--intro" data-slide data-label="Introduzione">
          <div class="slide__intro">
            <p class="mono muted" data-in>Selezione — {pad(total)} tavole</p>
            <Split as="h2" id="showcase-title" class="display display--wide showcase__title" lines={['Selected', 'works.']} lineClass={['', 'is-outline']} />
            <p class="slide__lead" data-in>
              Una piccola mostra con le opere dei due artisti di Kimera. Scorri: la sequenza si apre verso destra, una tavola alla volta.
            </p>
            <p class="slide__hint mono" data-in aria-hidden="true">Scorri <Arrow dir="r" size={14} /></p>
          </div>
        </li>

        {slides.map((s) => (
          <li
            class={`slide slide--${s.variant}`}
            data-slide
            data-label={`Tavola ${pad(s.index)}`}
            data-artist={s.work.artistName}
            style={`--r:${s.work.ratio.toFixed(3)}`}
          >
            {s.variant !== 'full' && <span class="slide__num display display--narrow" aria-hidden="true" data-num>{pad(s.index)}</span>}

            <figure class="slide__fig">
              <div class="slide__frame" data-frame>
                <div class="slide__par" data-par>
                  <Photo
                    image={s.work.image}
                    alt={s.detail ? `Dettaglio: ${s.work.alt}` : s.work.alt}
                    sizes={sizes[s.variant]}
                    widths={widths[s.variant]}
                    focal={s.work.focal}
                    plateVariant={s.index}
                    plateQuiet
                  />
                </div>
                <Marks size={14} inset={10} />
              </div>
              <figcaption class="slide__cap mono" data-in>
                {s.detail ? 'Dettaglio' : 'Fig.'} {pad(s.index)} — {s.work.artistName}
                {s.work.placeholder && <span class="slide__slot"> · Foto da inserire: {s.work.slot}</span>}
              </figcaption>
            </figure>

            <div class="slide__text" data-in-group>
              <p class="mono slide__kicker" data-in>
                {s.detail ? 'Dettaglio' : 'Opera'} {pad(s.index)} <span class="muted">/ {s.work.artistName}</span>
              </p>
              <p class="slide__line serif" data-in>{s.line}</p>
            </div>
          </li>
        ))}

        <li class="slide slide--outro" data-slide data-label="Conclusione">
          <div class="slide__intro">
            <p class="mono muted" data-in>Fine della sequenza</p>
            <Split as="h2" class="display display--wide showcase__title showcase__title--sm" lines={['The full', 'archive.']} lineClass={['', 'is-outline']} noAuto />
            <p class="slide__lead" data-in>
              {hasRealWorks ? 'Il portfolio completo è qui sotto.' : 'Il portfolio completo, con filtri e lightbox, è nella sezione qui sotto.'}
            </p>
            <div class="slide__ctas" data-in>
              <a class="btn btn--solid" href="#portfolio" data-scroll-to="#portfolio" data-track="cta_showcase_portfolio"><span>Apri il portfolio</span><Arrow dir="d" /></a>
              <a class="btn" href="#contact" data-scroll-to="#contact" data-track="cta_showcase_contact"><span>Richiedi un appuntamento</span><Arrow /></a>
            </div>
          </div>
        </li>
      </ol>
    </div>

    <div class="showcase__bottom" aria-hidden="true">
      <p class="mono showcase__artist"><span class="muted">Artista —</span> <span data-artist-label>—</span></p>
      <div class="showcase__bar"><i data-bar></i></div>
      <p class="mono muted showcase__hint">Scroll</p>
    </div>
  </div>
</section>

<style>
  .showcase {
    position: relative;
    background: var(--ink-0);
    color: var(--bone);
  }
  .showcase__pin {
    position: relative;
    padding-top: calc(var(--header-h) + 1.5rem);
    padding-bottom: 2rem;
  }
  .showcase__top,
  .showcase__bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding-inline: var(--pad);
  }
  .showcase__top { margin-bottom: 1.5rem; }
  .showcase__count { font-size: 0.85rem; }
  .showcase__bottom { margin-top: 1.5rem; }
  .showcase__bar {
    position: relative;
    flex: 1;
    max-width: 520px;
    height: 1px;
    background: var(--line-2);
  }
  .showcase__bar i {
    position: absolute;
    inset: -1px auto -1px 0;
    width: 100%;
    background: var(--bone);
    transform: scaleX(0);
    transform-origin: left;
  }
  .showcase__hint { display: none; }

  /* — viewport / track: base = scorrimento nativo (mobile, no-JS, reduced motion) — */
  .showcase__viewport {
    overflow-x: auto;
    overflow-y: hidden;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--pad);
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }
  .showcase__viewport::-webkit-scrollbar { display: none; }
  .showcase__track {
    display: flex;
    gap: 14px;
    width: max-content;
    padding-inline: var(--pad);
  }
  .slide {
    position: relative;
    flex: none;
    width: 82vw;
    max-width: 520px;
    scroll-snap-align: start;
    display: grid;
    align-content: start;
    gap: 1rem;
  }
  .slide--b, .slide--full { max-width: 640px; }
  .slide__num {
    position: absolute;
    z-index: 3;
    left: 10px;
    top: 4px;
    font-size: 3.6rem;
    line-height: 1;
    color: transparent;
    -webkit-text-stroke: 1px var(--bone);
    mix-blend-mode: difference;
    pointer-events: none;
  }
  .slide__fig { position: relative; }
  .slide__frame {
    position: relative;
    overflow: hidden;
    background: var(--ink-3);
    aspect-ratio: clamp(0.72, var(--r), 1.5);
  }
  .slide__par { position: absolute; inset: 0; }
  :global(.is-pinned) .slide__par { inset: 0 -6%; }
  :global(.is-pinned) .slide--macro .slide__par { inset: 0; }
  .slide__cap { margin-top: 0.7rem; color: var(--steel); }
  .slide__slot { color: var(--accent-text); }
  .slide__text { display: grid; gap: 0.6rem; max-width: 34ch; }
  .slide__kicker { color: var(--bone); }
  .slide__line {
    font-size: clamp(1.35rem, 5.4vw, 1.9rem);
    line-height: 1.15;
    color: var(--bone);
  }
  .slide--macro .slide__frame { border-radius: 50%; aspect-ratio: 1; width: 100%; }
  .slide--macro .slide__par :global(.photo) { transform: scale(2.3); transform-origin: var(--fx) var(--fy); }

  .slide--intro, .slide--outro { width: 84vw; max-width: 640px; align-content: center; }
  .slide__intro { display: grid; gap: 1.2rem; align-content: center; min-height: 360px; }
  :global(.showcase__title) {
    font-size: clamp(2.6rem, 11vw, 6rem);
    line-height: 0.86;
  }
  .slide__lead { color: var(--bone-2); max-width: 36ch; }
  .slide__hint { display: inline-flex; align-items: center; gap: 0.8rem; color: var(--steel); }
  .slide__ctas { display: flex; flex-wrap: wrap; gap: 0.7rem; }

  /* ═════════ DESKTOP: sezione fissata, scorrimento orizzontale guidato dallo scroll ═════════ */
  @media (min-width: 900px) {
    .showcase__pin {
      height: 100svh;
      min-height: 640px;
      padding: 0;
      overflow: hidden;
    }
    .showcase__top,
    .showcase__bottom {
      position: absolute;
      left: 0;
      right: 0;
      z-index: 6;
      margin: 0;
      pointer-events: none;
    }
    .showcase__top { top: calc(var(--header-h) + 8px); }
    .showcase__bottom { bottom: 28px; }
    .showcase__hint { display: block; }
    .showcase__viewport {
      position: absolute;
      inset: 0;
      scroll-snap-type: none;
    }
    :global(.is-pinned) .showcase__viewport { overflow: hidden; }
    .showcase__track {
      gap: 0;
      height: 100%;
      padding-inline: var(--pad) 0;
      will-change: transform;
    }
    .slide {
      width: auto;
      max-width: none;
      height: 100%;
      display: flex;
      align-items: center;
      padding-block: calc(var(--header-h) + 5vh) 11vh;
      scroll-snap-align: none;
      gap: 0;
    }
    .slide__frame { aspect-ratio: auto; }
    .slide__cap { position: absolute; left: 0; bottom: -2.1rem; margin: 0; white-space: nowrap; }

    /* intro / outro */
    .slide--intro { width: 76vw; padding-right: 8vw; }
    .slide--outro { width: 72vw; padding-right: 10vw; }
    .slide__intro { min-height: 0; gap: 1.6rem; }
    :global(.showcase__title) { font-size: clamp(5rem, 12.6vw, 17rem); }
    :global(.showcase__title--sm) { font-size: clamp(4rem, 9.6vw, 13rem); }
    .slide__lead { font-size: 1.1rem; max-width: 40ch; }

    /* A — verticale: tavola + testo laterale + numero gigante dietro */
    .slide--a { width: 58vw; padding-left: 7vw; }
    .slide--a .slide__fig {
      --h: min(68vh, 760px);
      width: min(calc(var(--h) * var(--r)), 40vw);
      z-index: 2;
    }
    .slide--a .slide__frame { width: 100%; aspect-ratio: var(--r); max-height: var(--h); }
    .slide--a .slide__num {
      left: 2vw;
      top: calc(var(--header-h) + 6vh);
      font-size: clamp(10rem, 24vw, 28rem);
      line-height: 0.78;
      z-index: 1;
      mix-blend-mode: normal;
      -webkit-text-stroke: 1px var(--line-2);
    }
    .slide--a .slide__text { position: relative; z-index: 3; margin-left: 3.2vw; align-self: flex-end; max-width: 22ch; }
    .slide--a .slide__line { font-size: clamp(1.5rem, 2.1vw, 2.3rem); }

    /* B — orizzontale: testo in alto a sinistra, tavola larga in basso, numero che invade la cornice */
    .slide--b { width: 94vw; padding-left: 5vw; align-items: flex-end; }
    .slide--b .slide__fig {
      --h: min(56vh, 600px);
      width: min(calc(var(--h) * var(--r)), 62vw);
      margin-left: 4vw;
      z-index: 2;
    }
    .slide--b .slide__frame { width: 100%; aspect-ratio: var(--r); }
    .slide--b .slide__text {
      position: absolute;
      left: 6vw;
      top: calc(var(--header-h) + 9vh);
      max-width: 26ch;
      z-index: 3;
    }
    .slide--b .slide__line { font-size: clamp(1.5rem, 2.2vw, 2.5rem); }
    .slide--b .slide__num {
      left: auto;
      top: auto;
      right: 4vw;
      bottom: 6vh;
      font-size: clamp(8rem, 18vw, 22rem);
      line-height: 0.8;
      z-index: 4;
    }

    /* MACRO — dettaglio circolare, "lente" con anello graduato */
    .slide--macro { width: 70vw; padding-left: 5vw; }
    .slide--macro .slide__fig {
      width: min(62vh, 36vw);
      aspect-ratio: 1;
      z-index: 2;
      margin-top: -2vh;
    }
    .slide--macro .slide__frame { width: 100%; height: 100%; aspect-ratio: 1; border-radius: 50%; }
    .slide--macro .slide__fig::before {
      content: '';
      position: absolute;
      inset: -16px;
      border-radius: 50%;
      border: 1px solid var(--line-2);
      background: repeating-conic-gradient(from 0deg, var(--line-2) 0 .4deg, transparent .4deg 3deg);
      -webkit-mask: radial-gradient(circle, transparent calc(100% - 10px), #000 calc(100% - 9px));
      mask: radial-gradient(circle, transparent calc(100% - 10px), #000 calc(100% - 9px));
    }
    .slide--macro .slide__text { position: relative; z-index: 3; margin-left: 5vw; max-width: 24ch; align-self: center; }
    .slide--macro .slide__num { left: auto; right: 4vw; top: calc(var(--header-h) + 5vh); font-size: clamp(7rem, 16vw, 20rem); line-height: .8; mix-blend-mode: normal; -webkit-text-stroke: 1px var(--line-2); }
    .slide--macro .slide__cap { left: 50%; transform: translateX(-50%); }
    .slide--macro .slide__frame :global(.marks) { display: none; }

    /* FULL — climax a tutto schermo */
    .slide--full { width: 100vw; padding: 0; }
    .slide--full .slide__fig { position: absolute; inset: 0; }
    .slide--full .slide__frame { position: absolute; inset: 0; width: 100%; height: 100%; }
    .slide--full .slide__par { inset: 0 -4%; }
    .slide--full .slide__frame::after {
      content: '';
      position: absolute;
      inset: 0;
      background: linear-gradient(0deg, rgb(5 5 5 / .85) 0%, rgb(5 5 5 / .15) 45%, transparent 70%);
      pointer-events: none;
    }
    .slide--full .slide__text { position: absolute; left: 8vw; bottom: 14vh; z-index: 4; max-width: 28ch; }
    .slide--full .slide__line { font-size: clamp(1.8rem, 2.8vw, 3.2rem); }
    .slide--full .slide__cap { left: auto; right: 6vw; bottom: 3.2rem; }
  }
</style>
