---
/**
 * PHOTO — immagine ottimizzata (AVIF + WebP + fallback, srcset responsive,
 * lazy di default) oppure Plate segnaposto quando manca la foto originale.
 * Riempie il contenitore padre (position:absolute; inset:0).
 */
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Plate from './Plate.astro';

interface Props {
  image?: ImageMetadata;
  alt?: string;
  sizes?: string;
  widths?: number[];
  loading?: 'eager' | 'lazy';
  priority?: boolean;
  focal?: { x: number; y: number };
  class?: string;
  plateN?: number | string;
  plateSlot?: string;
  plateVariant?: number;
  plateKind?: string;
  plateQuiet?: boolean;
}
const {
  image, alt = '', sizes = '100vw', widths = [480, 800, 1200, 1800, 2400], loading = 'lazy', priority = false,
  focal = { x: 0.5, y: 0.5 }, class: klass = '',
  plateN, plateSlot, plateVariant, plateKind, plateQuiet,
} = Astro.props;
const usable = image ? widths.filter((w) => w <= image.width) : [];
if (image && !usable.length) usable.push(image.width);
---
<div class={`photo ${klass}`} style={`--fx:${(focal.x * 100).toFixed(1)}%;--fy:${(focal.y * 100).toFixed(1)}%`}>
  {image ? (
    <Picture
      src={image}
      alt={alt}
      widths={usable}
      sizes={sizes}
      formats={['avif', 'webp']}
      fallbackFormat="jpg"
      loading={priority ? 'eager' : loading}
      fetchpriority={priority ? 'high' : 'auto'}
      decoding={priority ? 'sync' : 'async'}
    />
  ) : (
    <Plate n={plateN} slot={plateSlot} variant={plateVariant} kind={plateKind} quiet={plateQuiet} />
  )}
</div>
<style is:global>
  .photo { position: absolute; inset: 0; overflow: hidden; container-type: inline-size; }
  .photo img { width: 100%; height: 100%; object-fit: cover; object-position: var(--fx, 50%) var(--fy, 50%); }
</style>
